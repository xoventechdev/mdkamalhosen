# ---------------------------------------------------------------------------
# Copy this file to ".env.local" and fill in your own values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# SERVER-only secrets: anything without NEXT_PUBLIC_ is server-side only.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (server-only, used by the Mongoose driver).
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/portfolio
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/portfolio?retryWrites=true&w=majority

# Vercel Blob storage token (server-only). Create in Vercel -> Storage.
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Single allowed admin email (the only account that may write content).
ADMIN_EMAIL=mdkamalhosennn@gmail.com

# Bcrypt hash of the admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=$2a$10$...

# HMAC secret used to sign the admin session cookie (>= 32 chars).
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-with-openssl-rand-base64-48-output

# Public site URL (used for SEO, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://kamalhosen.dev

# Contact form: messages arrive here + optional SMTP for reliable delivery
CONTACT_TO_EMAIL=mdkamalhosennn@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=portfolio@kamalhosen.dev

# On-demand revalidation secret (call /api/revalidate?secret=...&path=...)
REVALIDATE_SECRET=generate-a-long-random-string-here
