# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# All others are server-side only.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (server-only, used by the Mongoose driver).
# Use the STANDARD (non-SRV) form below. The mongodb+srv:// form relies on
# DNS SRV lookups, which fail inside Next.js's dev runtime on Windows
# (`querySrv ECONNREFUSED _mongodb._tcp.*.mongodb.net`).
#
# To find your replica set name: connect via mongosh with the SRV URI and
# run `rs.status()`, or query `{ replSetGetStatus: 1 }` against the admin DB.
#
# Format:
#   mongodb://USER:PASS@host1:27017,host2:27017,host3:27017/portfolio
#     ?ssl=true
#     &replicaSet=atlas-XXXXXX-shard-0
#     &retryWrites=true
#     &w=majority
#     &authSource=admin
MONGODB_URI=mongodb://USER:PASS@host1.mongodb.net:27017,host2.mongodb.net:27017,host3.mongodb.net:27017/portfolio?ssl=true&replicaSet=atlas-XXXXXX-shard-0&retryWrites=true&w=majority&authSource=admin

# Vercel Blob storage token (server-only). Create in Vercel -> Storage.
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public site URL (used for SEO, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://kamalhosen.dev

# ---------------------------------------------------------------------------
# Admin auth (DB-backed via the admin_users collection).
#   Create the first admin with:
#     npm run seed:admin -- --email you@example.com --password 'long-strong-password-12+'
#   Then change the password in /admin/settings.
# ---------------------------------------------------------------------------

# HMAC secret used to sign the admin session cookie (>= 32 chars).
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-with-openssl-rand-base64-48-output

# On-demand revalidation secret (call /api/revalidate?secret=...&path=...)
# Generate with: openssl rand -base64 32
REVALIDATE_SECRET=replace-with-openssl-rand-base64-32-output

# ---------------------------------------------------------------------------
# SMTP (used by the password-reset email and the admin smoke-test route).
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM=you@example.com
