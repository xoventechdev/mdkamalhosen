generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Single-row table for owner profile / contact / mission.
model Profile {
  id             Int     @id @default(1)
  name           String
  role           String
  tagline        String
  location       String
  relocate       Boolean @default(true)
  email          String
  phone          String?
  linkedinUrl    String?
  githubUrl      String?
  whatsapp       String?
  summary        String
  mission        String
  philosophy     String
  values         String[]
  availability   String  @default("open") // open | limited | closed
  avatarUrl      String?
  cvPdfUrl       String?

  updatedAt DateTime @updatedAt

  @@map("profile")
}

model Experience {
  id             Int      @id @default(autoincrement())
  company        String
  role           String
  country        String
  city           String?
  startDate      DateTime
  endDate        DateTime?
  current        Boolean  @default(false)
  bullets        String[]
  stack          String[]
  marqueeProject String?
  sortOrder      Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([company, role, startDate])
  @@map("experiences")
}

model Education {
  id          Int     @id @default(autoincrement())
  degree      String
  institution String
  startYear   Int
  endYear     Int?
  status      String // ongoing | completed
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([degree, institution, startYear])
  @@map("education")
}

model Certification {
  id             Int     @id @default(autoincrement())
  name           String
  issuer         String
  year           Int?
  credentialUrl  String?
  sortOrder      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, issuer])
  @@map("certifications")
}

model SkillGroup {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  sortOrder Int     @default(0)

  skills Skill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("skill_groups")
}

model Skill {
  id        Int     @id @default(autoincrement())
  groupId   Int
  name      String
  platform  String?
  years     Int?
  level     Int     @default(3) // 1..5
  sortOrder Int     @default(0)

  group SkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("skills")
}

enum ProjectCategory {
  bms
  software
  iot
  android
}

enum ProjectStatus {
  draft
  published
}

model Project {
  id            Int             @id @default(autoincrement())
  slug          String          @unique
  title         String
  category      ProjectCategory @default(bms)
  year          Int
  clientType    String?
  excerpt       String
  coverUrl      String?
  problem       String?
  role          String?
  techStack     String[]
  challenges    String?
  solution      String?
  outcome       String?
  lessons       String?
  galleryImages String[]
  links         Json?
  featured      Boolean         @default(false)
  status        ProjectStatus    @default(draft)
  sortOrder     Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projects")
}

enum BlogStatus {
  draft
  published
}

model BlogPost {
  id              Int         @id @default(autoincrement())
  slug            String      @unique
  title           String
  excerpt         String?
  coverUrl        String?
  bodyMd          String      @default("")
  status          BlogStatus  @default(draft)
  publishedAt     DateTime?
  readingMinutes  Int         @default(1)
  metaDescription String?

  tags BlogTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_posts")
}

model BlogTag {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  slug  String  @unique

  posts BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_tags")
}

model Message {
  id        Int       @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String
  ipPrefix  String?
  readAt    DateTime?
  archived  Boolean    @default(false)

  createdAt DateTime @default(now())

  @@map("messages")
}

model ActivityLog {
  id        Int     @id @default(autoincrement())
  userEmail String
  action    String // created | updated | deleted
  entity    String
  entityId  Int?
  meta      Json?

  createdAt DateTime @default(now())

  @@map("activity_log")
}